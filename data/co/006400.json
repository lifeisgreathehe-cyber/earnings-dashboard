gin":[-4.9,5.5,9.7],"temperature":{"n":7,"median_upside":-78.8,"share_above":100,"label":"과열(낙관 쪽)","shift":1},"verdict":"낙관 시나리오도 넘는 가격","tone":"neg","note":"지금 주가가 맞으려면 이익이 연 10%씩 늘면서 순이익률 17.0%가 이어져야 해요(과거 -4.9%~9.7%, 평균 5.5%, 이 계산의 정상 이익 가정 6.8%). 과거 최고보다 높은 수익성을 이미 가격에 넣은 상태라, 좋은 소식이 나와도 '예상대로'일 뿐이고 실망하면 하락폭이 커요. 업종 전체가 과열(낙관 쪽) 상태라 확률을 비관 쪽으로 조금 옮겼어요. 불황이 길어지면 최대 약 78% 손실, 낙관 시나리오면 -31%로 손익 구조는 '불리'예요."},"verdict":"낙관 시나리오도 넘는 가격","their":{"base":193159,"updated":"2026-11-13"},"growth":{"ni_cagr5":3.7,"sales_cagr5":3.3,"sales_cagr10":11.0,"hist_g":3.5}},"lynch_cat":"경기순환주","asset_play":false,"checks":{"buffett":[{"name":"10년 평균 ROE 15% 이상","ok":false,"val":"5.2%","note":""},{"name":"ROE 10% 넘은 해가 대부분(80% 이상)","ok":false,"val":"2/10년","note":""},{"name":"적자 낸 해가 없음","ok":false,"val":"2025","note":""},{"name":"주주이익(영업현금흐름−설비투자)이 순이익의 70% 이상","ok":false,"val":"-217%","note":"최근 5년 합계 기준"},{"name":"부채비율 100% 이하","ok":true,"val":"79%","note":"금융사는 제외"},{"name":"영업이익률이 안정적(변동계수 0.35 미만)","ok":false,"val":"5.67","note":""}],"lynch":[{"name":"PEG 1 이하 (PER ÷ 과거 성장률)","ok":false,"val":"37.77","note":"성장률 = 지배순이익·매출 5년 연평균 성장률의 평균(최대 25%)"},{"name":"(성장률+배당수익률) ÷ PER 1.5 이상","ok":false,"val":"0.03","note":"2 이상이면 매우 좋음"},{"name":"순현금 보유","ok":false,"val":"-106,054억","note":""},{"name":"부채가 자본보다 적음","ok":true,"val":"79%","note":""}],"fisher":[{"name":"매출이 꾸준히 늘어남(최근 5년 중 4년 이상 증가)","ok":false,"val":"10년 중 7년 증가","note":"피셔 1번 질문: 매출 성장 잠재력"},{"name":"영업이익률 개선(최근 3년 평균 > 이전 평균)","ok":false,"val":"-1.2% vs 2.7%","note":"피셔 5·6번 질문: 이익률과 개선 노력"},{"name":"가까운 장래 증자 없이 성장 가능(주주이익 플러스)","ok":false,"val":"5년 합 -110,424억","note":"피셔 13번 질문"}]},"annual":[{"year":2016,"sales":52008.2,"gp":7505.7,"sga":16769.1,"op":-9263.3,"ni_ctrl":2194.1,"equity_ctrl":107221.3,"ocf":-13095.2,"op_margin":-17.8,"roe":2.0,"oe":-21511.6},{"year":2017,"sales":63466.1,"gp":11658.5,"sga":10489.5,"op":1168.9,"ni_ctrl":6572.4,"equity_ctrl":112573.0,"ocf":-2501.1,"op_margin":1.8,"roe":5.8,"oe":-12452.0},{"