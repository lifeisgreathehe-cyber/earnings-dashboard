1.7,"op":163.3,"ni_ctrl":20.2,"op_margin":9.9,"prelim":false,"ni_est":false},{"q":"2025Q4","sales":1365.0,"gp":233.5,"sga":232.9,"op":118.9,"ni_ctrl":-146.8,"op_margin":8.7,"prelim":false,"ni_est":false},{"q":"2026Q1","sales":1519.3,"gp":308.1,"sga":215.6,"op":204.0,"ni_ctrl":278.3,"op_margin":13.4,"prelim":false,"ni_est":false},{"q":"2026Q2","sales":1423.5,"gp":297.8,"sga":202.8,"op":253.4,"ni_ctrl":316.2,"op_margin":17.8,"prelim":false,"ni_est":false},{"q":"2026Q3","sales":1345.3,"gp":286.2,"sga":189.5,"op":195.2,"ni_ctrl":55.5,"op_margin":14.5,"prelim":false,"ni_est":false}],"ttm":[{"q":"2021Q4","sales":6740.1,"op":883.7,"ni_ctrl":218.1},{"q":"2022Q1","sales":6377.4,"op":738.7,"ni_ctrl":242.1},{"q":"2022Q2","sales":6482.7,"op":711.7,"ni_ctrl":229.9},{"q":"2022Q3","sales":6592.3,"op":651.3,"ni_ctrl":137.2},{"q":"2022Q4","sales":6498.9,"op":330.0,"ni_ctrl":-60.9},{"q":"2023Q1","sales":6449.9,"op":264.0,"ni_ctrl":-99.8},{"q":"2023Q2","sales":6331.0,"op":208.3,"ni_ctrl":-52.9},{"q":"2023Q3","sales":6324.3,"op":206.0,"ni_ctrl":3.3},{"q":"2023Q4","sales":6372.6,"op":168.8,"ni_ctrl":-37.2},{"q":"2024Q1","sales":6607.2,"op":180.2,"ni_ctrl":-0.2},{"q":"2024Q2","sales":6703.4,"op":160.1,"ni_ctrl":-9.8},{"q":"2024Q3","sales":6788.5,"op":154.0,"ni_ctrl":-4.2},{"q":"2024Q4","sales":6766.7,"op":381.3,"ni_ctrl":245.7},{"q":"2025Q1","sales":6527.1,"op":324.4,"ni_ctrl":199.7},{"q":"2025Q2","sales":6481.9,"op":346.1,"ni_ctrl":474.5},{"q":"2025Q3","sales":6507.4,"op":442.0,"ni_ctrl":462.8},{"q":"2025Q4","sales":6301.1,"op":477.4,"ni_ctrl":234.4},{"q":"2026Q1","sales":6296.3,"op":650.0,"ni_ctrl":509.0},{"q":"2026Q2","sales":5963.1,"op":739.6,"ni_ctrl":467.9},{"q":"2026Q3","sales":5653.1,"op":771.5,"ni_ctrl":503.2}],"deep":{"summary":"콜마홀딩스는 최근 4개 분기 영업이익이 2025년 연간보다 62% 많고 PER 7.7배인데, 공시 뒤 주가는 2.4%만 올라 '투자가치' 알림 조건을 충족했어요(DART 3분기 보고서 기준). 다만 3분기만 보면 영업이익 195억원으로 전년 같은 분기보다 20% 늘었지만 직전 분기(253억원)보다는 23% 줄었어요. 이익의 상당 부분이 자회사 지분법이익이라 지주사 할인을 감안해야 해요.","business":"한국콜마(화장품 ODM·HK이노엔)를 지분법으로, 콜마비앤에이치(건강기능식품) 등을 연결로 거느린 지주사예요. 2025~2026년 화장품 사업 일부를 한국콜마로 넘기면서 연결 매출은 줄었어요.","quarter":"3분기 매출 1,345억원, 영업이익 195억원(이익률 14.5%), 지배주주 순이익 56억원이에요. 1분기 204억원, 2분기 253억원에 이어 3분기에도 영업이익 200억원 안팎을 유지했어요. 영업이익에 비해 순이익이 작은 건 영업외 손실 영향이에요(세부는 확인 필요).","drivers":["한국콜마의 국내 ODM 호황에 따른 지분법이익 증가","화장품 사업 이전 뒤 지주사 비용 구조 정리","콜마비앤에이치 해외 ODM 회복 여부"],"risks":["지분법이익은 현금으로 바로 들어오지 않아 배당으로만 주주에게 돌아옴","오너 일가 경영권 분쟁 재발 가능성","한국콜마 해외 법인(중국·미국·캐나다) 부진"],"news":["한국콜마 3분기 실적은 국내 호조, 해외 법인 부진이라는 보도가 이어졌어요(연도별 수치는 원문 확인 필요)"],"analysts":["지주사는 증권사 분석이 적은 편이라 컨센서스는 쓰지 않았어요"],"moat":"지주사 자체의 해자는 없고, 핵심 자회사 한국콜마의 ODM 경쟁력(고객 기반·생산 규모)에 기대는 구조예요.","conclusion":"화장품 산업 대시보드는 정상 이익을 약 250억원(전환율 0.6)으로 봐서 기준 적정가 약 5,950원, 낙관 7,130원으로 현재가 8,550원보다 낮게 나와 '낙관 시나리오도 넘는 가격'으로 분류돼요. 다만 이 계산은 이익만 보는 방식이라 PBR 0.34배가 말해 주는 자산가치(한국콜마 등 보유 지분)는 반영하지 않아요. 결국 이익 기준으로는 비싸 보이고, 자산 기준으로는 크게 할인된 지주사예요. 알림이 잡힌 PER 7.7배는 지분법이익이 포함된 숫자라 그대로 싸다고 보긴 어렵고, 지분 가치가 배당이나 지배구조 개선으로 주주에게 돌아올지가 관건이에요.","buffett":"버핏 관점: ROE 4.4%로 낮고 이익이 크게 흔들려 버핏 기준엔 맞지 않아요. 다만 자산 대비 가격이 매우 싸다는 점은 그레이엄식 관점에서 볼 만해요.","lynch":"린치 관점: 자산주(asset play)에 가까워요. 린치는 숨은 자산이 있는 회사를 좋아했지만, 그 가치가 드러날 계기(배당 확대·지분 정리)가 있어야 한다고 했어요.","conservative":"보수적 투자자 관점: 빚 부담은 크지 않지만 이익 구조가 복잡하고 경영권 분쟁 이력이 있어 마음 편한 종목은 아니에요.","fisher":[{"q":"앞으로 몇 년간 매출이 크게 늘 만한 시장이 있는가","a":"K-뷰티 ODM(한국콜마)과 건강기능식품(콜마비앤에이치) 수요는 늘고 있지만, 지주사 자체 매출은 화장품 사업 이전으로 줄었어요.","score":1},{"q":"현재 제품의 성장이 끝나도 신제품으로 매출을 키우려는 경영진의 의지가 있는가","a":"자회사들이 화장품·제약(HK이노엔)·건기식으로 사업을 넓혀 왔어요.","score":1},{"q":"연구개발 규모에 비해 성과가 좋은가","a":"연구개발은 주로 자회사에서 이뤄져 지주사 단위로는 판단하기 어려워요(확인 필요).","score":1},{"q":"평균 이상의 영업 조직이 있는가","a":"한국콜마는 국내외 브랜드사 고객 기반이 넓은 ODM 선두권이에요.","score":2},{"q":"이익률이 충분히 높은가","a":"최근 4개 분기 영업이익률은 약 12%지만 지분법이익 비중이 커서 본업 이익률로 보긴 어려워요. 지난 10년 순이익률은 -1~17%로 크게 흔들렸어요.","score":1},{"q":"이익률을 유지·개선하려는 노력을 하는가","a":"화장품 사업을 한국콜마로 넘기고 지주 기능에 집중하는 구조로 바뀌는 중이에요.","score":1},{"q":"노사관계가 좋은가","a":"공개 자료로는 판단하기 어려워요(확인 필요).","score":1},{"q":"임원 간 관계가 좋은가","a":"2025년 오너 일가 사이에 콜마비앤에이치 경영권을 두고 분쟁이 있었어요. 지금 어떻게 정리됐는지는 확인이 필요해요.","score":0},{"q":"경영진이 두터운가","a":"그룹 지주 체제로 운영돼요(세부는 확인 필요).","score":1},{"q":"원가 분석과 회계 관리가 잘 되는가","a":"연결 순이익이 일회성 손익과 지분법으로 크게 출렁여요(2025년 4분기 -147억, 2026년 3분기 56억).","score":1},{"q":"경쟁자보다 뛰어난 업종 특유의 강점이 있는가","a":"한국콜마는 국내 화장품 ODM 2강이에요.","score":2},{"q":"단기보다 장기 이익을 보는가","a":"HK이노엔 인수처럼 장기 사업 확장을 해 왔어요.","score":1},{"q":"가까운 미래에 증자로 주주 몫이 희석될 가능성이 있는가","a":"순차입이 약 1,600억원(9월 말)이고 자본에 비해 크지 않아 희석 우려는 낮아요.","score":2},{"q":"일이 잘 안 풀릴 때도 투자자에게 솔직하게 말하는가","a":"공개 자료로는 판단하기 어려워요(확인 필요).","score":1},{"q":"경영진의 정직성에 의문이 없는가","a":"가족 간 경영권 분쟁은 지배구조 측면의 감점 요인이에요.","score":1}],"fisher_total":17,"sources":[{"title":"DART 콜마홀딩스 공시","url":"https://dart.fss.or.kr/dsab007/main.do?option=corp&textCrpNm=%EC%BD%9C%EB%A7%88%ED%99%80%EB%94%A9%EC%8A%A4"},{"title":"한국콜마 3분기 실적 기사(디지털데일리)","url":"https://www.ddaily.co.kr/page/view/2025110710424633093"},{"title":"한국콜마 해외법인 관련 기사(뉴스토마토)","url":"https://www.newstomato.com/ReadNews.aspx?no=1319903"}],"updated":"2026-11-19"},"kbeauty":{"review":"3분기 영업이익 +20%, 매출은 −19%","note":"연결 순이익이 일회성·지분법으로 크게 흔들려(2024년 246억, 2025년 234억, 최근 4개 분기 약 470억원) 300억원을 정상 이익으로 봤어요. 지주 비용·배당 의존을 반영해 전환율을 0.6으로 낮췄어요.","verdict":"기대 선반영"}}